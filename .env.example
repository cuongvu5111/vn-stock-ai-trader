# ============================================================
# PERSONAL AI TRADING ASSISTANT — ENVIRONMENT CONFIGURATION
# Copy this file to .env for local development.
# DO NOT commit .env or real secrets to version control.
# ============================================================

# Application
APP_NAME=Personal AI Trading Assistant
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_db
POSTGRES_USER=trader
DB_PASSWORD=change_me_local_only

# Paper Trading Defaults (VND)
INITIAL_PAPER_CAPITAL=30000000
MARKET_TIMEZONE=Asia/Ho_Chi_Minh

# Optional AI Analysis Configuration (Leave empty to use MockAiAnalysisProvider)
AI_ENABLED=false
AI_PROVIDER=mock
AI_MODEL=mock-v1
AI_API_KEY=
LLM_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=
