# ============================================================
# PERSONAL AI TRADING ASSISTANT — ENVIRONMENT CONFIGURATION
# Copy this file to .env for local development.
# DO NOT commit .env or real secrets to version control.
# Chạy bằng Docker Compose (kể cả LAN): BẮT BUỘC điền DB_PASSWORD, JWT_SECRET_KEY, BOOTSTRAP_ADMIN_PASSWORD
# (compose dừng ngay nếu thiếu). Sinh nhanh: .\scripts\generate-secrets.ps1  (xem README mục "Chạy trong LAN").
# ============================================================

# Application
APP_NAME=Personal AI Trading Assistant
# development = dev trên máy (bật Swagger, không kiểm tra cứng hóa). Docker Compose mặc định production khi biến này không đặt;
# với LAN nên đặt APP_ENV=production (tắt Swagger; backend từ chối khởi động nếu DB_PASSWORD yếu/CORS_ORIGINS/TRUSTED_HOSTS không hợp lệ).
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Host header backend chấp nhận (phân tách bằng dấu phẩy, không kèm cổng). Để trống: dev không kiểm tra, Compose dùng
# localhost,127.0.0.1,trading-backend (nginx luôn gửi Host=trading-backend). Bắt buộc không trống khi APP_ENV != development/test.
TRUSTED_HOSTS=

# Docker Compose / LAN: CHỈ dashboard (nginx) có thể mở ra LAN. PostgreSQL và backend luôn chỉ bind 127.0.0.1.
# 127.0.0.1 = chỉ máy chủ này (mặc định an toàn). Muốn truy cập từ máy khác trong LAN: đặt IP LAN của máy chủ (ví dụ 192.168.1.10).
# Truy cập là HTTP thường, KHÔNG mã hóa: chỉ dùng trong LAN tin cậy, không port-forward ra Internet.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=4200

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_db
POSTGRES_USER=trader
# BẮT BUỘC điền (≥ 12 ký tự ngẫu nhiên, chỉ gồm A-Za-z0-9._~- vì được ghép vào URL kết nối). Ví dụ: python -c "import secrets; print(secrets.token_hex(24))"
# PostgreSQL chỉ nhận mật khẩu này ở lần khởi tạo volume đầu tiên; đổi sau đó phải ALTER USER (xem README).
DB_PASSWORD=

# Paper Trading Defaults (VND)
INITIAL_PAPER_CAPITAL=30000000
# Múi giờ thị trường BẮT BUỘC là Asia/Ho_Chi_Minh (migration 0004 hardcode múi giờ này); giá trị khác làm backend từ chối khởi động.
MARKET_TIMEZONE=Asia/Ho_Chi_Minh
# Thanh toán T+N: cổ phiếu mua hôm nay (T) chỉ bán được từ ngày làm việc thứ N sau T (bỏ thứ 7/CN; chưa tính ngày lễ sàn). Hợp lệ 0..10.
SETTLEMENT_LAG_TRADING_DAYS=2

# Authentication (JWT + Argon2) — BẮT BUỘC cấu hình; backend từ chối khởi động nếu thiếu/yếu/placeholder.
# Sinh secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Swagger (/docs, /redoc, /openapi.json) chỉ bật khi APP_ENV=development.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# Admin đầu tiên (seed idempotent khi chạy migration/seed). Mật khẩu tối thiểu 12 ký tự; để trống = không seed.
# Docker Compose BẮT BUỘC có BOOTSTRAP_ADMIN_PASSWORD. Chỉ dùng khi chưa có user trùng tên, không bao giờ ghi đè mật khẩu user đã có
# (đổi mật khẩu sau này bằng chức năng đổi mật khẩu của dashboard, không phải bằng biến này).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Scheduler Daily EOD (APScheduler). Mặc định TẮT. Múi giờ cố định Asia/Ho_Chi_Minh, chạy thứ 2-6, coalesce, max_instances=1.
# Job chỉ chạy workflow đến TradeProposal(PendingApproval): không tự duyệt, không tự khớp, không tự nhập dữ liệu SAMPLE.
# Chạy đúng 1 backend/1 worker uvicorn khi bật. Lần chạy bị lỡ quá SCHEDULER_MISFIRE_GRACE_SECONDS bị bỏ qua.
SCHEDULER_ENABLED=false
DAILY_EOD_HOUR=16
DAILY_EOD_MINUTE=30
SCHEDULER_MISFIRE_GRACE_SECONDS=3600

# Sao lưu tự động: docker compose --profile backup up -d postgres-backup
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_KEEP=3

# Optional AI Analysis Configuration (Leave empty to use MockAiAnalysisProvider)
AI_ENABLED=false
AI_PROVIDER=mock
AI_MODEL=mock-v1
AI_API_KEY=
LLM_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=
